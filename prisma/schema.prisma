// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PARTNER
  BUSINESS_EXECUTIVE
  BUSINESS_CONSULTANT
  // Clients are not users of the platform
}

// Add these enum definitions
enum TaskStatus {
  pending
  in_progress
  review
  completed
  cancelled
}

enum TaskPriority {
  low
  medium
  high
}

enum BillingStatus {
  pending_billing
  billed
  paid
}

// Which company a task or piece of work belongs to
enum Company {
  MVC
  BEDGE
}

// Each bill type has its own number series (see docs/BILLING.md)
enum BillType {
  GST         // MVC & Company
  NON_GST     // CA Mukul Verma
  NON_GST_HV  // CA Harsh Verma
  NON_GST_VLA // Verma Law Associates
  BEDGE       // B Edge
}

enum BillStatus {
  draft            // waiting for the billing manager
  awaiting_amount  // sent to a partner/admin to enter the amount
  amount_entered   // waiting for billing manager approval
  manager_approved // waiting for admin final approval
  approved         // numbered and in the Billing List
  cancelled
  not_billable
}

// How a bill last went back a step (see docs/BILLING.md)
enum BillReturnKind {
  sent_back      // by the person asked for the amount: back to the billing manager
  final_rejected // by Admin at final approval: back to the billing manager
}

// What happened to the last email of a bill (see docs/BILLING.md)
enum BillEmailStatus {
  sent    // accepted by Gmail; no failure reported
  delayed // the recipient's server is not accepting it yet; Gmail keeps trying
  failed  // not delivered; the reason is in emailError
}

enum BillChangeKind {
  edit    // same number, new amount/details
  cancel  // number stays in the series, marked cancelled
  reissue // old bill cancelled, new bill with a new number
}

enum BillChangeStatus {
  pending
  approved
  rejected
}

model User {
  id                      String         @id @default(uuid()) @db.Char(36)
  name                    String         @db.VarChar(50)  // 50 chars is enough for most names
  email                   String         @unique @db.VarChar(75)  // Most emails are under 75 chars
  phone                   String?        @db.VarChar(15)  // International format with country code
  password                String?        @db.VarChar(100) // Keep 100 for secure hashes
  passwordResetToken      String?        @db.VarChar(100)
  passwordResetTokenExpiry DateTime?     
  role                    UserRole       @default(BUSINESS_EXECUTIVE)
  avatar                  String?        @db.VarChar(150) // Reduce from 255
  isActive                Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  updatedById             String?        // ID of the user who last updated this user
  roleVersion             Int            @default(1)
  // Relations
  // DEPRECATED: Legacy assignment field - use taskAssignments instead
  createdTasks            Task[]         @relation("AssignedByUser")
  // PRIMARY: Use this relation for all task assignments
  taskAssignments         TaskAssignee[] @relation("UserTaskAssignments")
  lastStatusUpdatedTasks  Task[]         @relation("LastStatusUpdater")
  notificationsSent       Notification[] @relation("SentBy")
  notificationsReceived   Notification[] @relation("SentTo")
  activities              Activity[]
  managedClients          Client[]       // Staff who manages clients
  taskComments            TaskComment[]
  clientHistories         ClientHistory[] @relation("CreatedBy")
  canApproveBilling       Boolean        @default(false) // Whether this user can approve billing (also: MVC billing manager)
  canManageBedgeBilling   Boolean        @default(false) // B Edge billing manager
  canEnterBillAmounts     Boolean        @default(false) // Partner bills can be sent to for the amount
  canViewBillingList      Boolean        @default(false) // Partner who sees the whole Billing List and emails bills
  billingListTypes        BillType[]     @default([]) // Which Billing Lists that partner sees; empty = all
  pushSubscriptions       PushSubscription[]
  billsCreated            Bill[]         @relation("BillCreatedBy")
  billsAmountRequested    Bill[]         @relation("BillAmountRequestedFrom")
  billsAmountEntered      Bill[]         @relation("BillAmountEnteredBy")
  billsReturned           Bill[]         @relation("BillReturnedBy")
  billEvents              BillEvent[]
  billChangesRequested    BillChangeRequest[] @relation("BillChangeRequestedBy")
  billChangesDecided      BillChangeRequest[] @relation("BillChangeDecidedBy")
  tallyExports            TallyExport[]
  complianceTeams         ComplianceTeamMember[]
  complianceItemsUpdated  ComplianceItem[]      @relation("ComplianceItemUpdatedBy")
  complianceEvents        ComplianceEvent[]
  complianceDocuments     ComplianceDocument[]
  complianceReminders     ComplianceReminder[]
  complianceCompleted     ComplianceItem[]      @relation("ComplianceItemCompletedBy")
  complianceChecked       ComplianceItem[]      @relation("ComplianceItemCheckedBy")
  gstWorkingChecks        GstWorkingCheck[]     @relation("GstWorkingCheckedBy")
  obligationLinesResolved ComplianceObligationLine[]
  clientDispatches        ClientDispatch[]
  gstPortalJobs           GstPortalJob[]

  // For frequently accessed active users
  @@index([isActive], name: "active_users_idx")
}

model Client {
  id             String       @id @default(uuid()) @db.Char(36)
  contactPerson  String       @db.VarChar(50)   // Owner's name
  companyName    String?      @db.VarChar(75)   // Reduced from 150
  email          String?      @db.VarChar(75)   // Reduced from 255
  phone          String?      @db.VarChar(15)   // First of the owner's numbers (kept in step with phones)
  // Owner's mobile numbers: [{ number, label, whatsapp }] (see lib/client-contacts.ts)
  phones         Json?
  // When false, compliance reminders go to the responsible person instead
  ownerIsResponsible Boolean  @default(true)
  responsibleName    String?  @db.VarChar(50)
  responsiblePhone   String?  @db.VarChar(15)
  responsibleEmail   String?  @db.VarChar(75)
  // The connector who brought the client: bills go to the connector's ledger
  connectorId    String?      @db.Char(36)
  connector      Connector?   @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  // Added without a Tally ledger by someone who may not set it: the billing
  // manager is reminded until they do
  address        String?      @db.VarChar(150)  // Reduced from 255
  notes          String?      @db.Text        // Keep as Text for longer content
  gstin          String?      @db.VarChar(15) // Standard GSTIN is 15 chars
  // Registration numbers, sent to the client on request (Send to Client)
  pan            String?      @db.VarChar(10)
  tan            String?      @db.VarChar(10)
  cin            String?      @db.VarChar(21) // CIN or LLPIN
  udyamNumber    String?      @db.VarChar(19) // UDYAM-MP-12-0012345
  iec            String?      @db.VarChar(10)
  tallyLedgerPending Boolean  @default(false)
  tallyLedgerName String?     @db.VarChar(100) // Party ledger in Tally, if not the client's name
  // Another state's GST registration of a party: its own GSTIN, returns and
  // GST working, under the party's main record (Compliance → Clients)
  parentClientId String?      @db.Char(36)
  parentClient   Client?      @relation("ClientRegistrations", fields: [parentClientId], references: [id], onDelete: SetNull)
  registrations  Client[]     @relation("ClientRegistrations")
  isGuest        Boolean      @default(false) // Whether this is a temporary guest client
  accessExpiry   DateTime?    // When guest client access expires
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  // Relations
  managerId      String       @db.Char(36) // The staff member who manages this client
  manager        User         @relation(fields: [managerId], references: [id])
  tasks          Task[]       // Tasks associated with this client
  attachments    Attachment[] // Attachments related to this client
  history        ClientHistory[] // Client history entries
  credentials    Credential[] //Credentials associated with this client
  bills          Bill[]
  complianceSubscriptions ClientCompliance[]
  complianceItems         ComplianceItem[]
  complianceDocuments     ComplianceDocument[]
  obligations             ClientObligation[]
  complianceNotes         ComplianceNote[]
  dispatches              ClientDispatch[]
  gstWorkingChecks        GstWorkingCheck[]
  gstPortalJobs           GstPortalJob[]
  gstJsonRequests         GstJsonRequest[]
  
  @@index([managerId])
  @@index([contactPerson]) // Index for searching by contact person name
  @@index([connectorId])
  @@index([parentClientId])
}

// Someone who brings clients to the firm. Fees of their clients are collected
// from them, so those bills go to the connector's ledger in Tally.
model Connector {
  id              String   @id @default(uuid()) @db.Char(36)
  name            String   @db.VarChar(100)
  phone           String?  @db.VarChar(15)
  email           String?  @db.VarChar(75)
  tallyLedgerName String?  @db.VarChar(100) // Defaults to the name
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clients Client[]
  bills   Bill[]
}

model Task {
  id             String    @id @default(uuid()) @db.Char(36)
  title          String    @db.VarChar(150) // Reduced from 255
  description    String?   @db.Text        // Keep as Text for longer content
  status         TaskStatus    @default(pending) // Changed from String
  priority       TaskPriority  @default(medium)  // Changed from String
  dueDate        DateTime?
  billingStatus  BillingStatus? @default(pending_billing) // Changed from String?
  billingDate    DateTime?
  scheduledDeletionDate DateTime? // Add this field
  company        Company   @default(MVC)
  bill           Bill?

  // Add these new fields
  lastStatusUpdatedById String?   @db.Char(36)
  lastStatusUpdatedBy   User?     @relation("LastStatusUpdater", fields: [lastStatusUpdatedById], references: [id])
  lastStatusUpdatedAt   DateTime?
  
  // DEPRECATED: Legacy assignment fields - use assignees instead
  // These fields are kept for backward compatibility but should not be used for new code
  assignedById   String    @db.Char(36)
  assignedBy     User      @relation("AssignedByUser", fields: [assignedById], references: [id])
  
  // PRIMARY: Use this relation for all task assignments
  assignees      TaskAssignee[]
  
  // Keep other existing relations
  client         Client?   @relation(fields: [clientId], references: [id])
  clientId       String?   @db.Char(36)
  comments       TaskComment[]
  // Any other existing fields/relations
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // For overdue tasks - frequently queried
  @@index([status, dueDate(sort: Asc)], name: "overdue_tasks_idx")

  @@index([assignedById])
  @@index([clientId])
  @@index([billingStatus])
  @@index([createdAt])
}

// New join table for many-to-many task assignments
model TaskAssignee {
  id          String    @id @default(uuid()) @db.Char(36)
  taskId      String    @db.Char(36)
  userId      String    @db.Char(36)
  assignedAt  DateTime  @default(now())
  
  // Relations
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User      @relation("UserTaskAssignments", fields: [userId], references: [id], onDelete: Cascade)
  
  // Unique constraint
  @@unique([taskId, userId])
  // "Tasks assigned to me" lookups filter by userId alone
  @@index([userId])
}

model Attachment {
  id          String   @id @default(uuid()) @db.Char(36)
  filename    String   @db.VarChar(150) // Reduced from 255
  path        String   @db.VarChar(255) // Reduced from 512
  mimetype    String   @db.VarChar(50)  // Reduced from 100
  size        Int
  clientId    String?  @db.Char(36) // Optional relation to client
  client      Client?  @relation(fields: [clientId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

// Web Push subscription for one browser/device (e.g. the iPhone home-screen app)
model PushSubscription {
  id        String   @id @default(uuid()) @db.Char(36)
  endpoint  String   @unique @db.Text
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  userAgent String?  @db.VarChar(255)
  userId    String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id          String   @id @default(uuid()) @db.Char(36)
  title       String   @db.VarChar(75) // Reduced from 100
  content     String?  @db.Text  // Keep as Text for longer content
  isRead      Boolean  @default(false)
  taskId      String?  @db.Char(36) // Optional relation to task
  
  // Who sent the notification
  sentById    String   @db.Char(36)
  sentBy      User     @relation("SentBy", fields: [sentById], references: [id])
  
  // Who received the notification
  sentToId    String   @db.Char(36)
  sentTo      User     @relation("SentTo", fields: [sentToId], references: [id])
  
  createdAt   DateTime @default(now())

  @@index([sentById])
  @@index([sentToId, createdAt(sort: Desc)])
}

model Activity {
  id        String   @id @default(uuid()) @db.Char(36)
  type      String   // "client", "user", "task", "project", "document"
  action    String   // "created", "updated", "deleted", "assigned", "completed", "role_changed"
  target    String   // What was affected (name of client, user, task, etc.)
  details   Json?    // Additional context as JSON (optional)
  userId    String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([type])
  @@index([userId])
  @@index([createdAt])
}

model TaskComment {
  id          String    @id @default(uuid()) @db.Char(36)
  content     String    @db.Text  // Keep as Text for longer content
  taskId      String    @db.Char(36)
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String    @db.Char(36)
  user        User      @relation(fields: [userId], references: [id])
  attachments Json?     // Add this field to store attachment metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
  @@index([userId])
}

model ClientHistory {
  id                String    @id @default(uuid()) @db.Char(36)
  clientId          String    @db.Char(36)
  client            Client    @relation(fields: [clientId], references: [id])
  content           String    @db.Text  // Keep as Text for longer content
  type              String    @default("general") @db.VarChar(50)
  createdAt         DateTime  @default(now())
  createdById       String    @db.Char(36)
  createdBy         User      @relation("CreatedBy", fields: [createdById], references: [id])
  pinned           Boolean   @default(false) // Whether this history entry is pinned for quick access
  
  // Task related fields
  taskId            String?   @db.Char(36)
  taskTitle         String?   @db.VarChar(255)
  taskDescription   String?   @db.Text  // Keep as Text for longer content
  taskStatus        String?   @db.VarChar(50)
  taskCompletedDate DateTime?
  taskBilledDate    DateTime?
  billingDetails    Json?

  @@index([clientId])
  @@index([createdById])
  @@index([taskId])
}

model Credential {
  id        String   @id @default(uuid()) @db.Char(36)
  title     String   @db.VarChar(75) // Reduced from 100
  username  String   @db.VarChar(75) // Reduced from 100
  password  String   @db.VarChar(100) // Keep 100 for secure hashes
  clientId  String   @db.Char(36)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

// A bill for one task or one directly logged piece of work (docs/BILLING.md)
model Bill {
  id          String     @id @default(uuid()) @db.Char(36)
  company     Company
  type        BillType? // null until the billing manager picks GST or Non-GST
  status      BillStatus @default(draft)
  description String     @db.Text
  workDate    DateTime
  remark      String?    @db.Text

  // Set when the bill comes from a task; null for directly logged work
  taskId      String? @unique @db.Char(36)
  task        Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  clientId    String? @db.Char(36)
  client      Client? @relation(fields: [clientId], references: [id])
  createdById String  @db.Char(36)
  createdBy   User    @relation("BillCreatedBy", fields: [createdById], references: [id])
  // "Other": billed to someone who is not a saved client
  billToName    String? @db.VarChar(150)
  billToAddress String? @db.Text
  billToGstin   String? @db.VarChar(15)
  // Clients of a connector: the client's GSTIN is printed (and the bill
  // reported as B2B) only when this is ticked; otherwise it is B2C
  showGstin     Boolean @default(false)
  // Set at final approval, so a later change of the client's connector or
  // ledger doesn't move a numbered bill to another ledger
  connectorId     String?    @db.Char(36)
  connector       Connector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  tallyLedgerName String?    @db.VarChar(100)
  // When the bill reached its current stage (or was sent to another person
  // for the amount); kept by a database trigger. Used by the daily reminders.
  statusChangedAt DateTime   @default(now())

  // Professional fee before GST
  amount                Decimal?  @db.Decimal(12, 2)
  amountRequestedFromId String?   @db.Char(36)
  amountRequestedFrom   User?     @relation("BillAmountRequestedFrom", fields: [amountRequestedFromId], references: [id])
  // Optional remark from the billing manager when sending for the amount
  amountRequestNote     String?   @db.Text
  amountEnteredById     String?   @db.Char(36)
  amountEnteredBy       User?     @relation("BillAmountEnteredBy", fields: [amountEnteredById], references: [id])
  amountEnteredAt       DateTime?

  // The last time the bill was sent back or returned by Admin, with the
  // comment, shown on the bill until final approval so the next person sees
  // why. returnCount counts every time it went back.
  returnKind   BillReturnKind?
  returnRemark String?         @db.Text
  returnedAt   DateTime?
  returnedById String?         @db.Char(36)
  returnedBy   User?           @relation("BillReturnedBy", fields: [returnedById], references: [id])
  returnCount  Int             @default(0)

  // Given at admin final approval
  financialYear String?   @db.VarChar(7) // e.g. "2026-27"
  sequence      Int?
  billNumber    String?   @db.VarChar(30)
  billDate      DateTime?

  // A reissued bill points to the bill it replaced
  reissuedFromId String? @unique @db.Char(36)
  reissuedFrom   Bill?   @relation("BillReissue", fields: [reissuedFromId], references: [id])
  reissuedAs     Bill?   @relation("BillReissue")

  // Tally: when the bill was last sent, and whether a later change still has to be sent
  tallyExportedAt  DateTime?
  tallyNeedsUpdate Boolean      @default(false)
  tallyExportId    String?      @db.Char(36)
  tallyExport      TallyExport? @relation(fields: [tallyExportId], references: [id])

  // Last time the bill was emailed to the party, to whom, and whether it was
  // delivered. emailMessageId matches bounce notices to the email.
  emailedAt      DateTime?
  emailedTo      String?          @db.VarChar(400)
  emailStatus    BillEmailStatus?
  emailError     String?          @db.Text
  emailStatusAt  DateTime?
  emailMessageId String?          @db.VarChar(200)

  events         BillEvent[]
  changeRequests BillChangeRequest[]
  // Set when the bill comes from a completed compliance item
  complianceItem ComplianceItem?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([type, financialYear, sequence])
  @@index([company, status])
  @@index([amountRequestedFromId, status])
  @@index([createdById])
  @@index([clientId])
  @@index([connectorId])
}

// History of everything done to a bill
model BillEvent {
  id        String   @id @default(uuid()) @db.Char(36)
  billId    String   @db.Char(36)
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  action    String   @db.VarChar(40)
  remark    String?  @db.Text
  details   Json? // e.g. the previous values when an approved bill is edited
  userId    String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([billId, createdAt])
}

// Billing manager's request to edit, cancel or reissue an approved bill;
// Admin approves or rejects it
model BillChangeRequest {
  id             String           @id @default(uuid()) @db.Char(36)
  billId         String           @db.Char(36)
  bill           Bill             @relation(fields: [billId], references: [id], onDelete: Cascade)
  kind           BillChangeKind
  reason         String           @db.Text
  // New values for edit/reissue: amount, description, workDate, clientId, type
  changes        Json?
  status         BillChangeStatus @default(pending)
  requestedById  String           @db.Char(36)
  requestedBy    User             @relation("BillChangeRequestedBy", fields: [requestedById], references: [id])
  decidedById    String?          @db.Char(36)
  decidedBy      User?            @relation("BillChangeDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionRemark String?          @db.Text
  createdAt      DateTime         @default(now())

  @@index([status, createdAt])
  @@index([billId])
}

// Next number for each bill series; restarts at 1 every 1 April
model BillSeries {
  type          BillType @id
  financialYear String   @db.VarChar(7) // year that nextNumber belongs to
  nextNumber    Int
  updatedAt     DateTime @updatedAt
}

// Letterhead and payment details printed on each type of bill; Admin edits
// these in Billing → Company profiles
model BillingEntity {
  type        BillType @id
  name        String   @db.VarChar(100)
  address     String?  @db.Text
  phone       String?  @db.VarChar(30)
  email       String?  @db.VarChar(75)
  pan         String?  @db.VarChar(10)
  gstin       String?  @db.VarChar(15)
  // GST state code, e.g. "23" for Madhya Pradesh; decides CGST+SGST or IGST
  stateCode   String?  @db.VarChar(2)
  sacCode     String?  @db.VarChar(10)
  bankName    String?  @db.VarChar(100)
  bankAccount String?  @db.VarChar(30)
  bankIfsc    String?  @db.VarChar(11)
  bankBranch  String?  @db.VarChar(100)
  signatory   String?  @db.VarChar(100)
  footerNote  String?  @db.Text
  // Names as they are in Tally; defaults are used while these are empty
  tallyCompany     String? @db.VarChar(100)
  tallyVoucherType String? @db.VarChar(50)
  tallySalesLedger String? @db.VarChar(100)
  tallyCgstLedger  String? @db.VarChar(100)
  tallySgstLedger  String? @db.VarChar(100)
  tallyIgstLedger  String? @db.VarChar(100)
  tallyRoundOffLedger String? @db.VarChar(100)
  updatedAt   DateTime @updatedAt
}

// How bills are emailed to clients; a single row (id 1) that Admin edits in
// Billing → Bill emails
model BillingEmailSetting {
  id           Int      @id @default(1)
  // Off: the email asks clients to write to the firm's contact address, and
  // replies go there
  allowReplies Boolean  @default(false)
  // Where replies go when they are allowed
  replyTo      String?  @db.VarChar(75)
  // Gets a hidden copy (BCC) of every bill email
  copyTo       String?  @db.VarChar(75)
  // Reading bounce notices from the billing mailboxes: when they were last
  // read, how far ("MVC=<uidValidity>:<last uid>;BEDGE=…"), and why the last
  // read failed
  bounceCheckedAt  DateTime?
  bounceCheckpoint String?   @db.VarChar(60)
  bounceCheckError String?   @db.Text
  updatedAt    DateTime @updatedAt
}

// One Tally XML file that was downloaded; kept so the same file can be
// downloaded again if the import has to be repeated. Only the latest few of
// each series are kept, gzipped (see lib/tally.ts)
model TallyExport {
  id          String   @id @default(uuid()) @db.Char(36)
  type        BillType
  // Files from before compression; new files go in xmlGzip
  xml         String?  @db.Text
  xmlGzip     Bytes?
  newCount    Int
  updateCount Int
  createdById String   @db.Char(36)
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  bills       Bill[]

  @@index([type, createdAt])
}

// ─── Compliance (recurring statutory work, see docs/COMPLIANCE.md) ───────────

// What a work type does beyond the common steps; locks and completion rules
// depend on it (see lib/compliance.ts)
enum ComplianceKind {
  GSTR1
  GSTR3B
  TDS_PAYMENT
  TDS_RETURN
  GENERIC
}

enum ComplianceFrequency {
  MONTHLY
  QUARTERLY // financial-year quarters: Apr–Jun, Jul–Sep, Oct–Dec, Jan–Mar
  YEARLY // financial year
}

enum ComplianceStatus {
  pending
  data_received
  filed
  completed
  not_required // e.g. a TDS return for a quarter without challans
}

// When a TDS return needs Form 16/16A before it is complete
enum CertificateRule {
  NONE
  EVERY_QUARTER // 26Q: Form 16A every quarter
  Q4_ONLY // 24Q: Form 16 after the Q4 return
}

enum ObligationKind {
  RCM
  TDS
}

enum ObligationLineStatus {
  pending
  confirmed
  skipped
}

enum ReminderChannel {
  WHATSAPP
  EMAIL
}

enum ComplianceDocKind {
  RETURN_PDF
  RETURN_JSON
  GSTR1A_PDF
  GSTR1A_JSON
  GSTR2B_JSON
  CHALLAN
  CERTIFICATE
  OTHER
}

model ComplianceWorkType {
  id                      String              @id @default(uuid()) @db.Char(36)
  name                    String              @unique @db.VarChar(80)
  kind                    ComplianceKind      @default(GENERIC)
  // Default frequency; GST clients can be monthly or quarterly (allowQuarterly)
  frequency               ComplianceFrequency @default(MONTHLY)
  allowQuarterly          Boolean             @default(false)
  company                 Company             @default(MVC)
  // Due date: dueDay of the month dueMonthOffset months after the period ends.
  // Quarterly filers may have their own rule; dueExceptions overrides it for
  // periods ending in a given month, e.g. {"3": {"day": 30, "offset": 1}}
  dueDay                  Int
  dueMonthOffset          Int                 @default(1)
  quarterlyDueDay         Int?
  quarterlyDueMonthOffset Int?
  dueExceptions           Json?
  // Items appear this many days before the period ends (or before the due
  // date, if that is earlier)
  leadDays                Int                 @default(7)
  returnType              String?             @db.VarChar(5) // TDS returns: "24Q", "26Q"
  certificateRule         CertificateRule     @default(NONE)
  // Files needed, after filing, for the item to be completed
  requirePdf              Boolean             @default(false)
  requireJson             Boolean             @default(false)
  billable                Boolean             @default(false)
  defaultFeeNil           Decimal?            @db.Decimal(12, 2)
  defaultFeeNonNil        Decimal?            @db.Decimal(12, 2)
  reminderSubject         String              @db.VarChar(150)
  reminderMessage         String              @db.Text
  sortOrder               Int                 @default(100)
  active                  Boolean             @default(true)
  // Seeded work types; their kind can't be changed
  system                  Boolean             @default(false)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  team          ComplianceTeamMember[]
  subscriptions ClientCompliance[]
  items         ComplianceItem[]
}

// The staff who do a work type. Rotates every few months: a member who leaves
// the team gets toDate, so the history of who was on it stays.
model ComplianceTeamMember {
  id         String             @id @default(uuid()) @db.Char(36)
  workTypeId String             @db.Char(36)
  workType   ComplianceWorkType @relation(fields: [workTypeId], references: [id], onDelete: Cascade)
  userId     String             @db.Char(36)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDate   DateTime           @default(now())
  toDate     DateTime?

  @@index([workTypeId, toDate])
  @@index([userId])
}

// A client's recurring work, from startPeriod on
model ClientCompliance {
  id          String              @id @default(uuid()) @db.Char(36)
  clientId    String              @db.Char(36)
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workTypeId  String              @db.Char(36)
  workType    ComplianceWorkType  @relation(fields: [workTypeId], references: [id], onDelete: Cascade)
  frequency   ComplianceFrequency
  // A change between monthly and quarterly applies from frequencyFrom;
  // earlier periods keep previousFrequency
  previousFrequency ComplianceFrequency?
  frequencyFrom     DateTime?           @db.Date
  startPeriod DateTime            @db.Date
  endPeriod   DateTime?           @db.Date
  feeNil      Decimal?            @db.Decimal(12, 2)
  feeNonNil   Decimal?            @db.Decimal(12, 2)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([clientId, workTypeId])
  @@index([workTypeId, active])
}

// One period of one work for one client, e.g. ABC Traders – GSTR-3B – Oct 2026
model ComplianceItem {
  id              String              @id @default(uuid()) @db.Char(36)
  clientId        String              @db.Char(36)
  client          Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workTypeId      String              @db.Char(36)
  workType        ComplianceWorkType  @relation(fields: [workTypeId], references: [id], onDelete: Cascade)
  frequency       ComplianceFrequency
  periodStart     DateTime            @db.Date
  periodEnd       DateTime            @db.Date
  dueDate         DateTime            @db.Date
  status          ComplianceStatus    @default(pending)
  // Entered for a period before tracking started: no reminders, no bill
  historical      Boolean             @default(false)
  dataReceivedAt  DateTime?
  filedAt         DateTime?           @db.Date
  arn             String?             @db.VarChar(50) // ARN, token or acknowledgement number
  isNil           Boolean?
  taxPayable      Decimal?            @db.Decimal(14, 2)
  // Return figures used in the reconciliation (see lib/compliance.ts FIGURE_FIELDS)
  figures         Json?
  gstr1aFiled     Boolean             @default(false)
  gstr1aFiledAt   DateTime?           @db.Date
  gstr1aArn       String?             @db.VarChar(50)
  noTds           Boolean             @default(false) // TDS payment: nothing to pay this month
  certRequestedAt DateTime?           @db.Date
  certRequestNo   String?             @db.VarChar(50)
  certEmailedAt   DateTime?
  certEmailedTo   String?             @db.VarChar(400)
  completedAt     DateTime?
  // Overrides the client's fee for this period
  fee             Decimal?            @db.Decimal(12, 2)
  reminderCount   Int                 @default(0)
  lastReminderAt  DateTime?
  billId          String?             @unique @db.Char(36)
  bill            Bill?               @relation(fields: [billId], references: [id], onDelete: SetNull)
  updatedById     String?             @db.Char(36)
  updatedBy       User?               @relation("ComplianceItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  // Who filed the return (or closed the TDS month), and who checked it; the
  // same person when it was self-checked. Not asked for past periods.
  completedById   String?             @db.Char(36)
  completedBy     User?               @relation("ComplianceItemCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  checkedById     String?             @db.Char(36)
  checkedBy       User?               @relation("ComplianceItemCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  documents ComplianceDocument[]
  lines     ComplianceObligationLine[]
  challans  TdsChallan[]
  reminders ComplianceReminder[]
  events    ComplianceEvent[]
  notes     ComplianceNote[]

  @@unique([clientId, workTypeId, periodStart])
  @@index([workTypeId, periodEnd])
  @@index([status, dueDate])
}

model ComplianceEvent {
  id        String         @id @default(uuid()) @db.Char(36)
  itemId    String         @db.Char(36)
  item      ComplianceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  action    String         @db.VarChar(40)
  remark    String?        @db.Text
  userId    String?        @db.Char(36)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@index([itemId])
}

// A file kept in Cloudflare R2 (see lib/r2.ts). Files with the same content
// share one stored object (storageKey is derived from the SHA-256).
model ComplianceDocument {
  id           String            @id @default(uuid()) @db.Char(36)
  clientId     String            @db.Char(36)
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  itemId       String?           @db.Char(36)
  item         ComplianceItem?   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind         ComplianceDocKind
  fileName     String            @db.VarChar(150)
  contentType  String            @db.VarChar(80)
  storageKey   String            @db.VarChar(200)
  sha256       String            @db.Char(64)
  size         Int // bytes as stored (after compression)
  gzipped      Boolean           @default(false)
  uploadedById String?           @db.Char(36)
  uploadedBy   User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  // The client's own documents (Client → Documents), not tied to a period:
  // the type (lib/client-documents.ts) and, for yearly ones, the financial
  // year it belongs to (2025 = FY 2025-26)
  docType       String?          @db.VarChar(40)
  financialYear Int?
  // GST returns: the figures read from the file when it was uploaded (see
  // lib/gst-read) and the month they are for (a quarter's last month)
  gst          Json?
  gstMonth     DateTime?         @db.Date
  createdAt    DateTime          @default(now())

  @@index([clientId, createdAt])
  @@index([clientId, gstMonth])
  @@index([clientId, docType])
  @@index([itemId])
  @@index([storageKey])
}

// Something a client pays every month that must not be missed: RCM on rent or
// transport (checked in GSTR-3B), or TDS on rent, salary, fees (checked in the
// TDS payment). fixedAmount null = the amount changes every month.
model ClientObligation {
  id          String         @id @default(uuid()) @db.Char(36)
  clientId    String         @db.Char(36)
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind        ObligationKind
  category    String         @db.VarChar(60) // "Rent – unregistered", "194-I"
  payee       String         @db.VarChar(100)
  fixedAmount Decimal?       @db.Decimal(14, 2)
  ratePercent Decimal        @db.Decimal(5, 2)
  fromMonth   DateTime       @db.Date
  toMonth     DateTime?      @db.Date
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lines ComplianceObligationLine[]

  @@index([clientId, kind])
}

// An obligation's line on one item; the item can't be closed while a line is pending
model ComplianceObligationLine {
  id           String               @id @default(uuid()) @db.Char(36)
  itemId       String               @db.Char(36)
  item         ComplianceItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  obligationId String               @db.Char(36)
  obligation   ClientObligation     @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  baseAmount   Decimal?             @db.Decimal(14, 2)
  taxAmount    Decimal?             @db.Decimal(14, 2)
  status       ObligationLineStatus @default(pending)
  note         String?              @db.VarChar(300) // Required when skipped
  resolvedAt   DateTime?
  resolvedById String?              @db.Char(36)
  resolvedBy   User?                @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([itemId, obligationId])
}

model TdsChallan {
  id          String         @id @default(uuid()) @db.Char(36)
  itemId      String         @db.Char(36) // the month's TDS payment item
  item        ComplianceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  section     String         @db.VarChar(10)
  bsrCode     String?        @db.VarChar(7)
  challanDate DateTime       @db.Date
  serialNo    String?        @db.VarChar(10)
  amount      Decimal        @db.Decimal(14, 2)
  createdAt   DateTime       @default(now())

  @@index([itemId])
}

model ComplianceReminder {
  id       String          @id @default(uuid()) @db.Char(36)
  itemId   String          @db.Char(36)
  item     ComplianceItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  channel  ReminderChannel
  sentTo   String          @db.VarChar(400)
  ok       Boolean         @default(true)
  error    String?         @db.Text
  sentById String?         @db.Char(36)
  sentBy   User?           @relation(fields: [sentById], references: [id], onDelete: SetNull)
  sentAt   DateTime        @default(now())

  @@index([itemId])
  @@index([channel, sentAt])
}

// Short notes written by Claude's nightly review (through a database login that
// may only add rows here); shown to Admins and Partners on the dashboard
model ComplianceNote {
  id        String          @id @default(uuid()) @db.Char(36)
  clientId  String?         @db.Char(36)
  client    Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  itemId    String?         @db.Char(36)
  item      ComplianceItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  body      String          @db.Text
  source    String          @default("claude") @db.VarChar(20)
  createdAt DateTime        @default(now())

  @@index([createdAt])
}

// A reviewer's sign-off of one GST period in the client's GST working (see
// docs/GST_WORKING.md). The figures as they were when checked are kept, so a
// later upload that changes them shows the check as out of date.
model GstWorkingCheck {
  id          String   @id @default(uuid()) @db.Char(36)
  clientId    String   @db.Char(36)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodStart DateTime @db.Date
  checkedById String?  @db.Char(36)
  checkedBy   User?    @relation("GstWorkingCheckedBy", fields: [checkedById], references: [id], onDelete: SetNull)
  // Required when the period has a difference
  remark      String?  @db.Text
  snapshot    Json
  createdAt   DateTime @default(now())

  @@unique([clientId, periodStart])
}

// Firm-wide compliance settings, e.g. {"gstSwingPercent": 50}
model ComplianceSetting {
  key       String   @id @db.VarChar(40)
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── GST portal downloads ───────────────────────────────────────────────────
// Staff queue downloads; the helper program on an office PC opens the GST
// portal, staff type the captcha and OTP, and the helper saves the returns
// into the client's periods (see docs/GST_PORTAL_DOWNLOADS.md).
enum GstPortalJobStatus {
  QUEUED
  CLAIMED
  WAITING_LOGIN
  RUNNING
  DONE
  PARTLY_DONE
  FAILED
  CANCELLED
}

// One client, one portal login
model GstPortalJob {
  id            String             @id @default(uuid()) @db.Char(36)
  clientId      String             @db.Char(36)
  client        Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Month keys ("2025-04"), GSTR1 / GSTR3B / GSTR2B, PDF / JSON / EXCEL
  months        String[]
  returns       String[]
  formats       String[]
  status        GstPortalJobStatus @default(QUEUED)
  progress      String?            @db.VarChar(200)
  // The last ~40 lines: [{ at, text }]
  log           Json?
  filesSaved    Int                @default(0)
  error         String?            @db.Text
  helperName    String?            @db.VarChar(60)
  claimedAt     DateTime?
  heartbeatAt   DateTime?
  finishedAt    DateTime?
  requestedById String?            @db.Char(36)
  requestedBy   User?              @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  jsonRequests  GstJsonRequest[]

  @@index([status, createdAt])
  @@index([clientId, createdAt])
}

// A GSTR-1 "Generate JSON" request: the portal prepares the file in about
// 20 minutes, so it may be collected by a later job of the same client
model GstJsonRequest {
  id           String        @id @default(uuid()) @db.Char(36)
  clientId     String        @db.Char(36)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobId        String?       @db.Char(36)
  job          GstPortalJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  returnType   String        @db.VarChar(10)
  month        String        @db.VarChar(7)
  // REQUESTED | DOWNLOADED | EXPIRED | FAILED
  status       String        @default("REQUESTED") @db.VarChar(12)
  parts        Int?
  requestedAt  DateTime      @default(now())
  downloadedAt DateTime?

  @@index([clientId, returnType, month, status])
}

// ─── Send to Client ─────────────────────────────────────────────────────────
// Ready-made requests ("Last ITR", "Bank loan pack") that pick a client's
// files and details for one-click emailing (see docs/CLIENT_REQUESTS.md).
// Built-in ones have a key and are added by the app; Admin can edit or switch
// them off, and add their own.
model ClientRequestType {
  id          String   @id @default(uuid()) @db.Char(36)
  key         String?  @unique @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(300)
  category    String   @db.VarChar(30)
  // What it picks (lib/client-requests.ts RequestConfig)
  config      Json
  active      Boolean  @default(true)
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

// One email sent from Send to Client
model ClientDispatch {
  id             String   @id @default(uuid()) @db.Char(36)
  clientId       String   @db.Char(36)
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestName    String   @db.VarChar(100)
  company        Company
  sentTo         String   @db.VarChar(400)
  // Sent to an address that isn't on the client's record
  thirdParty     Boolean  @default(false)
  // [{ name, label }] of the files sent
  files          Json
  includedLogins Boolean  @default(false)
  sentById       String?  @db.Char(36)
  sentBy         User?    @relation(fields: [sentById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([createdAt])
}
