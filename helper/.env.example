# Copy this file to .env on the helper PC (never commit .env).

# The office app's address
PORTAL_URL=https://mvcompany.vercel.app
# The same value as GST_HELPER_KEY in Vercel (at least 32 characters)
GST_HELPER_KEY=
# Shown in the app ("Helper OFFICE-PC-1 is running")
HELPER_NAME=OFFICE-PC-1

# The helper only works on these days and hours (this PC's clock), so it
# doesn't wake the database at night. Days: 1 = Monday … 7 = Sunday.
ACTIVE_DAYS=1-6
ACTIVE_HOURS=10:00-20:00
# How often to ask the app for a new job while idle
POLL_SECONDS=60

# Where downloads are kept while they are uploaded
DOWNLOAD_DIR=./downloads
# false: delete each file from this PC once it is saved in the app
KEEP_LOCAL_COPIES=false

# How long to wait for staff to type the captcha and OTP
LOGIN_WAIT_MINUTES=10
# GSTR-1 JSON: first check after this long, then every few minutes, up to the maximum
JSON_READY_MINUTES=20
JSON_MAX_WAIT_MINUTES=45
JSON_CHECK_EVERY_MINUTES=3
