# Copy this file to ".env" next to index.mjs and fill it in (.env is never committed)
APP_URL=https://mvcompany.vercel.app
# Same value as WA_LISTENER_KEY in Vercel (Settings > Environment Variables). At least 20 characters.
WA_LISTENER_KEY=
# Where the WhatsApp login and the waiting messages are kept on this PC
DATA_DIR=C:\MVC\whatsapp-listener-data
# Minutes between batches in office hours (11:00-20:00 IST, Monday-Friday)
BATCH_MINUTES=30
